<Window x:Class="OnTalk.Sidecar.App.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="관리 · onTalk.sAIde" Width="600" Height="720" MinWidth="500" MinHeight="460"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel MaxWidth="760">
                <TextBlock Text="관리" Style="{StaticResource PageTitle}" />
                <TextBlock Text="보관 자료, 백업, 로컬 AI 모델, 단축키를 다룹니다." Style="{StaticResource Small}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,8" MaxWidth="760">

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="보관 자료" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="InfoText" Style="{StaticResource Small}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="단축키" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,0,0,12"
                                   Text="누를 때마다 패널이 접혔다 펴집니다. 아래 칸을 누른 뒤 원하는 키 조합을 누르면 키가 입력되는 대로 보이고, 마지막 키를 누르면 바로 적용됩니다. Ctrl·Alt·Win 중 하나는 꼭 함께 눌러야 합니다." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="접기·펴기" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     IsUndoEnabled="False" Cursor="Arrow" FontWeight="SemiBold"
                                     AutomationProperties.Name="접기 펴기 단축키 입력" ContextMenu="{x:Null}" />
                            <Button Grid.Column="2" Content="기본값" Margin="8,0,0,0" Click="OnResetHotkey" />
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource StatusLine}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="백업" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,0,0,12"
                                   Text="보관 자료는 이 Windows 사용자만 열 수 있게 잠겨 있어 폴더를 복사해서는 다른 PC에서 열 수 없습니다. 백업 파일은 아래 암호로 다시 잠가 만들므로 다른 PC로 옮길 수 있습니다. 암호를 잊으면 백업을 열 수 없습니다." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="백업 암호" VerticalAlignment="Center" />
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="한 번 더" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <PasswordBox x:Name="PasswordAgain" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="백업 파일 만들기…" Style="{StaticResource PrimaryButton}" Click="OnBackup" />
                            <Button Content="백업에서 되살리기…" Margin="8,0,0,0" Click="OnRestore" />
                        </StackPanel>
                        <TextBlock x:Name="BackupStatus" Style="{StaticResource StatusLine}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="로컬 AI 모델" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,0,0,12"
                                   Text="이 PC의 Ollama에 설치된 모델 가운데 고릅니다. 바꾼 모델은 프로그램을 다시 켠 뒤부터 쓰고, 그 모델로 쪽지 정리와 검색용 자료를 새로 만듭니다." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="정리·초안" VerticalAlignment="Center" />
                            <ComboBox x:Name="AnalysisModelBox" Grid.Column="1" IsEditable="True" />
                            <TextBlock Grid.Row="1" Text="뜻 검색" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox x:Name="EmbeddingModelBox" Grid.Row="1" Grid.Column="1" IsEditable="True"
                                      Margin="0,8,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ListModelsButton" Content="설치된 모델 확인" Click="OnListModels" />
                            <Button Content="모델 저장" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Click="OnSaveModels" />
                        </StackPanel>
                        <TextBlock x:Name="ModelStatus" Style="{StaticResource StatusLine}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="발송 기록" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,0,0,8"
                                   Text="이 프로그램의 '전송…'으로 누른 것만 남습니다. 온톡에서 직접 보낸 쪽지는 없습니다." />
                        <TextBlock x:Name="NoDispatchText" Text="기록이 없습니다." Foreground="{StaticResource Subtle}" />
                        <ItemsControl x:Name="DispatchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Small}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 되돌릴 수 없는 작업은 따로 떼어 붉게 -->
                <Border Style="{StaticResource Card}" Padding="18" Background="{StaticResource DangerSoft}"
                        BorderBrush="#F6C9C4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Foreground="{StaticResource Danger}"
                                   Text="모두 지우기" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,0,0,12"
                                   Text="이 계정으로 보관한 쪽지 사본, 업무, 초안, 문구, 그룹, 파일, 검색용 자료를 모두 지웁니다. 되돌릴 수 없습니다. 온톡에 있는 쪽지에는 영향이 없습니다." />
                        <Button Content="이 계정의 보관 자료 모두 지우기…" HorizontalAlignment="Left"
                                Style="{StaticResource DangerButton}" Background="White" Click="OnDeleteAll" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
