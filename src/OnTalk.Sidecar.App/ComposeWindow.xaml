<Window x:Class="OnTalk.Sidecar.App.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작성 도우미 · onTalk.sAIde" Width="680" Height="780" MinWidth="640" MinHeight="520"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 위: 어느 쪽지에, 누구에게 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="22,16,22,14">
            <StackPanel>
                <TextBlock x:Name="SourceText" Style="{StaticResource PageTitle}" FontSize="15" TextWrapping="Wrap" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="반영할 온톡 창" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="TargetBox" Grid.Column="1" DisplayMemberPath="Label"
                              SelectionChanged="OnTargetChanged" />
                </Grid>
                <TextBlock x:Name="TargetHint" Style="{StaticResource StatusSmall}" Margin="0,6,0,0" />

                <StackPanel x:Name="OnTalkControls">
                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,14,0,14" />

                    <!-- 받는 사람 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="받는 사람" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        <TextBox x:Name="RecipientName" Grid.Column="1" Tag="이름으로 찾기" />
                        <Button x:Name="FindButton" Grid.Column="2" Content="온톡에서 찾기" Margin="8,0,0,0"
                                Click="OnFindRecipient" />
                    </Grid>
                    <StackPanel x:Name="CandidatePanel" Visibility="Collapsed" Margin="92,8,0,0">
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="4">
                            <ListBox x:Name="CandidateList" MaxHeight="150" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailLine}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Button x:Name="AddRecipientButton" Content="고른 사람을 수신자로 추가" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="OnAddRecipient" />
                    </StackPanel>

                    <!-- 수신자 그룹 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="수신자 그룹" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="GroupBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="Label" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="그룹 넣기" Click="OnAddGroup" />
                            <Button Content="저장" Margin="6,0,0,0" Click="OnSaveGroup" ToolTip="넣은 사람을 그룹으로 저장" />
                            <Button Content="삭제" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="OnDeleteGroup" />
                        </StackPanel>
                    </Grid>

                    <!-- 예약 전송 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="예약 전송" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <DatePicker x:Name="ReserveDate" Width="136" />
                            <ComboBox x:Name="ReserveHour" Width="66" Padding="10,0,22,0" Margin="8,0,0,0" />
                            <TextBlock Text="시" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <ComboBox x:Name="ReserveMinute" Width="66" Padding="10,0,22,0" Margin="8,0,0,0" />
                            <TextBlock Text="분" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Button x:Name="ReserveButton" Content="온톡에 설정" Margin="12,0,0,0" Click="OnSetReservation" />
                            <Button x:Name="UnreserveButton" Content="예약 풀기" Margin="6,0,0,0" Click="OnCancelReservation" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ControlStatus" Style="{StaticResource StatusSmall}" Margin="92,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 아래: 바이트, 반영·전송 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="22,12,22,14">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="전송…" Style="{StaticResource PrimaryButton}"
                            MinHeight="36" Padding="22,0" Margin="8,0,0,0" Click="OnSend" />
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="온톡 창에 반영" MinHeight="36" Padding="18,0"
                            Click="OnApply" />
                    <TextBlock x:Name="ByteText" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock x:Name="ResultText" Style="{StaticResource StatusLine}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="반영한 뒤 온톡 창을 다시 읽어 본문과 바이트 표시가 초안과 같은지 확인합니다. 전송은 받는 사람·본문·예약을 다시 확인하는 창에서 승인해야만 실행되고, 결과가 불확실해도 다시 보내지 않습니다." />
            </StackPanel>
        </Border>

        <!-- AI로 쓰기 -->
        <Border DockPanel.Dock="Bottom" Margin="22,0,22,12">
            <StackPanel>
                <CheckBox x:Name="IncludeQuote" IsChecked="True" Visibility="Collapsed" Click="OnQuoteToggled"
                          Margin="0,0,0,10" />
                <Border Background="{StaticResource AccentSoft}" BorderBrush="#CFDBFF" BorderThickness="1"
                        CornerRadius="12" Padding="12,10">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="AiButton" DockPanel.Dock="Right" Content="AI로 쓰기"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnAiWrite" />
                            <TextBox x:Name="AiInstruction" Tag="이렇게 써 줘: 15일까지 이수하겠다고 정중히" />
                        </DockPanel>
                        <TextBlock x:Name="AiStatus" Style="{StaticResource Caption}" Margin="2,8,0,0"
                                   Text="요청을 적으면 로컬 AI가 초안을 씁니다. 이미 쓴 글이 있으면 그 글을 고칩니다." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 문구 -->
        <Grid DockPanel.Dock="Top" Margin="22,14,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="문구" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Width="92" />
            <ComboBox x:Name="TemplateBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="Name" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="넣기" Click="OnInsertTemplate" />
                <Button Content="지금 글을 저장" Margin="6,0,0,0" Click="OnSaveTemplate" />
                <Button Content="삭제" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="OnDeleteTemplate" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="Editor" Style="{StaticResource MultilineBox}" Margin="22,0,22,12" AcceptsTab="False"
                 FontSize="14" TextChanged="OnEditorChanged" Tag="여기에 쪽지 내용을 씁니다" />
    </DockPanel>
</Window>
