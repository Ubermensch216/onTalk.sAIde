<Window x:Class="OnTalk.Sidecar.App.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작성 도우미 · onTalk.sAIde" Width="620" Height="720" MinWidth="600" MinHeight="480"
        FontFamily="Malgun Gothic" FontSize="13" Background="White" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="SourceText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="반영할 온톡 창" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="TargetBox" DisplayMemberPath="Label" SelectionChanged="OnTargetChanged" />
                </DockPanel>
                <TextBlock x:Name="TargetHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <StackPanel x:Name="OnTalkControls">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="받는 사람 찾기" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="FindButton" DockPanel.Dock="Right" Content="온톡에서 찾기" Padding="10,2"
                                Margin="8,0,0,0" Click="OnFindRecipient" />
                        <TextBox x:Name="RecipientName" Padding="4,3" />
                    </DockPanel>
                    <StackPanel x:Name="CandidatePanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <ListBox x:Name="CandidateList" MaxHeight="150" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="AddRecipientButton" Content="고른 사람을 수신자로 추가" HorizontalAlignment="Left"
                                Padding="10,2" Margin="0,6,0,0" Click="OnAddRecipient" />
                    </StackPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="수신자 그룹" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="삭제" Padding="8,2" Margin="6,0,0,0" Click="OnDeleteGroup" />
                        <Button DockPanel.Dock="Right" Content="넣은 사람을 그룹으로 저장" Padding="8,2" Margin="6,0,0,0"
                                Click="OnSaveGroup" />
                        <Button DockPanel.Dock="Right" Content="그룹 넣기" Padding="10,2" Margin="8,0,0,0"
                                Click="OnAddGroup" />
                        <ComboBox x:Name="GroupBox" IsEditable="True" DisplayMemberPath="Label" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="예약 전송" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker x:Name="ReserveDate" Width="120" />
                        <ComboBox x:Name="ReserveHour" Width="52" Margin="8,0,0,0" />
                        <TextBlock Text="시" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <ComboBox x:Name="ReserveMinute" Width="52" Margin="8,0,0,0" />
                        <TextBlock Text="분" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Button x:Name="ReserveButton" Content="온톡에 설정" Padding="10,2" Margin="10,0,0,0"
                                Click="OnSetReservation" />
                        <Button x:Name="UnreserveButton" Content="예약 풀기" Padding="10,2" Margin="6,0,0,0"
                                Click="OnCancelReservation" />
                    </StackPanel>
                    <TextBlock x:Name="ControlStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="전송…" Padding="16,4"
                            Margin="8,0,0,0" Click="OnSend" />
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="온톡 창에 반영" Padding="16,4"
                            Margin="10,0,0,0" Click="OnApply" />
                    <TextBlock x:Name="ByteText" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="반영은 온톡 입력창을 클릭해 붙여넣는 방식이라 잠깐 마우스와 창이 움직입니다. 전송은 받는 사람·본문·예약을 다시 확인하는 창에서 승인해야만 실행되고, 결과가 불확실해도 다시 보내지 않습니다." />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,10">
            <CheckBox x:Name="IncludeQuote" IsChecked="True" Visibility="Collapsed" Click="OnQuoteToggled" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="AiButton" DockPanel.Dock="Right" Content="AI로 쓰기" Padding="12,3" Margin="8,0,0,0"
                        Click="OnAiWrite" />
                <TextBox x:Name="AiInstruction" Padding="4,3" />
            </DockPanel>
            <TextBlock x:Name="AiStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Text="요청을 적으면 로컬 AI가 초안을 씁니다. 예: 15일까지 이수하겠다고 정중히. 이미 쓴 글이 있으면 그 글을 고칩니다." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
            <Button DockPanel.Dock="Right" Content="삭제" Padding="8,2" Margin="6,0,0,0" Click="OnDeleteTemplate" />
            <Button DockPanel.Dock="Right" Content="지금 글을 저장" Padding="8,2" Margin="6,0,0,0" Click="OnSaveTemplate" />
            <Button DockPanel.Dock="Right" Content="넣기" Padding="10,2" Margin="6,0,0,0" Click="OnInsertTemplate" />
            <TextBlock DockPanel.Dock="Left" Text="문구" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TemplateBox" IsEditable="True" DisplayMemberPath="Name" />
        </DockPanel>

        <TextBox x:Name="Editor" Margin="14,0,14,8" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14" TextChanged="OnEditorChanged" />
    </DockPanel>
</Window>
