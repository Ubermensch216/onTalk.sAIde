<Window x:Class="OnTalk.Sidecar.App.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Border Margin="18,12,18,24" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="14" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <Grid Margin="22,22,22,0" MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBack" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top"
                        Margin="0,0,14,0" Background="{StaticResource AccentSoft}">
                    <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{StaticResource TextStrong}" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,20,22,20" />
        </StackPanel>
    </Border>
</Window>
