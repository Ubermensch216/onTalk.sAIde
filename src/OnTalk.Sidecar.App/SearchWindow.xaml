<Window x:Class="OnTalk.Sidecar.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검색 · onTalk.sAIde" Width="940" Height="680" MinWidth="680" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 검색줄 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="20,16,20,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="검색" Style="{StaticResource PrimaryButton}" Padding="22,0"
                            MinHeight="36" Margin="10,0,0,0" IsDefault="True" Click="OnSearch" />
                    <CheckBox x:Name="AttachmentOnly" DockPanel.Dock="Right" Content="첨부 있음" Margin="14,0,0,0"
                              VerticalAlignment="Center" Click="OnSearch" />
                    <ComboBox x:Name="Period" DockPanel.Dock="Right" Width="124" Margin="10,0,0,0" MinHeight="36"
                              SelectedIndex="0" SelectionChanged="OnPeriodChanged">
                        <ComboBoxItem Content="전체 기간" />
                        <ComboBoxItem Content="최근 7일" />
                        <ComboBoxItem Content="최근 30일" />
                        <ComboBoxItem Content="올해" />
                    </ComboBox>
                    <TextBox x:Name="QueryBox" MinHeight="36" FontSize="14" Tag="이름, 날짜, 쪽지 내용으로 찾습니다" />
                </DockPanel>
                <TextBlock x:Name="RangeText" Style="{StaticResource Small}" Margin="2,10,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Results" Margin="12,12,0,12" SelectionChanged="OnSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,2">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                               Foreground="{StaticResource AccentText}" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Snippet}" Style="{StaticResource Small}" MaxHeight="52"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Cursor="SizeWE">
                            <Rectangle Width="1" Fill="{StaticResource Line}" Margin="0,12" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Grid Grid.Column="2" Margin="0,12,12,12">
                <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoft}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="왼쪽에서 항목을 고르면 저장된 내용을 보여 줍니다." Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
                <Border x:Name="Detail" Style="{StaticResource Card}" Padding="0" Margin="0" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSub" Style="{StaticResource Small}" Margin="0,3,0,0" />
                            <TextBlock x:Name="DetailNotice" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DetailAttachments" DockPanel.Dock="Bottom" Margin="20,10,20,14"
                                   TextWrapping="Wrap" Style="{StaticResource Small}" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
                            <TextBox x:Name="DetailBody" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" Padding="20,14" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
