<Window x:Class="OnTalk.Sidecar.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검색 · onTalk.sAIde" Width="900" Height="640" MinWidth="640" MinHeight="400"
        FontFamily="Malgun Gothic" FontSize="13" Background="White" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="검색" Padding="16,3" Margin="8,0,0,0" IsDefault="True"
                            Click="OnSearch" />
                    <CheckBox x:Name="AttachmentOnly" DockPanel.Dock="Right" Content="첨부 있음" Margin="10,0,0,0"
                              VerticalAlignment="Center" Click="OnSearch" />
                    <ComboBox x:Name="Period" DockPanel.Dock="Right" Width="100" Margin="8,0,0,0" SelectedIndex="0"
                              SelectionChanged="OnPeriodChanged">
                        <ComboBoxItem Content="전체 기간" />
                        <ComboBoxItem Content="최근 7일" />
                        <ComboBoxItem Content="최근 30일" />
                        <ComboBoxItem Content="올해" />
                    </ComboBox>
                    <TextBox x:Name="QueryBox" Padding="6,4" />
                </DockPanel>
                <TextBlock x:Name="RangeText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Results" BorderThickness="0" SelectionChanged="OnSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11"
                                           Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" MaxHeight="52" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}" />
            <Grid Grid.Column="2">
                <TextBlock x:Name="DetailEmpty" Text="왼쪽에서 항목을 고르면 저장된 내용을 보여 줍니다."
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="24" />
                <DockPanel x:Name="Detail" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailSub" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailNotice" Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="DetailAttachments" DockPanel.Dock="Bottom" Margin="14,8,14,12"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="DetailBody" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,1,0,1"
                             BorderBrush="{StaticResource Line}" Padding="14,10" VerticalScrollBarVisibility="Auto"
                             Background="#FAFAFA" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
