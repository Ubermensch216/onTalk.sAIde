<Window x:Class="OnTalk.Sidecar.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="onTalk.sAIde" Width="360" Height="640" MinWidth="64" MinHeight="180"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <!-- 정리 중일 때 도는 동기화 표시 -->
        <Style x:Key="Spinner" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Text" Value="&#xE895;" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SpinBegin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinBegin" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionIcon" TargetType="Run">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#BFC8DC" BorderThickness="1" Background="{StaticResource PageBg}">
    <Grid>
    <!-- 접힌 모양: 온톡의 남색 사이드바와 같은 좁은 도구 -->
    <Border x:Name="Rail" Visibility="Collapsed" Background="{StaticResource Navy}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="onTalk.sAIde 끝내기" Click="OnExit" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
            <Button Width="52" Height="30" Margin="0,0,0,14" Click="OnExpand" ToolTip="패널 펼치기 · Ctrl+Shift+Space"
                    Style="{StaticResource OnNavyIconButton}" Background="White">
                <TextBlock FontFamily="Malgun Gothic" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{StaticResource Navy}"><Run Text="s" /><Run Text="AI" Foreground="{StaticResource Accent}" /><Run Text="de" /></TextBlock>
            </Button>
            <Button x:Name="RailSearchButton" Content="&#xE721;" Style="{StaticResource RailButton}"
                    Click="OnOpenSearch" IsEnabled="False" ToolTip="검색" />
            <Button x:Name="RailTasksButton" Content="&#xE73E;" Style="{StaticResource RailButton}"
                    Click="OnOpenTasks" IsEnabled="False" ToolTip="할 일 목록" />
            <Button x:Name="RailManageButton" Content="&#xE713;" Style="{StaticResource RailButton}"
                    Click="OnOpenManage" IsEnabled="False" ToolTip="관리" />
        </StackPanel>
    </Border>

    <!-- 펼친 모양 -->
    <DockPanel x:Name="Expanded">
        <!-- 머리줄: 온톡 사이드바와 같은 남색 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="14,10,8,10"
                MouseLeftButtonDown="OnHeaderMouseDown">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="onTalk.sAIde 끝내기" Click="OnExit" />
                </ContextMenu>
            </Border.ContextMenu>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ComposeButton" Content="&#xE70F;" Style="{StaticResource OnNavyIconButton}"
                            Click="OnNewDraft" IsEnabled="False" ToolTip="새 초안" />
                    <Button x:Name="SearchButton" Content="&#xE721;" Style="{StaticResource OnNavyIconButton}"
                            Click="OnOpenSearch" IsEnabled="False" ToolTip="검색" />
                    <Button x:Name="TasksButton" Content="&#xE73E;" Style="{StaticResource OnNavyIconButton}"
                            Click="OnOpenTasks" IsEnabled="False" ToolTip="할 일 목록" />
                    <Button x:Name="ManageButton" Content="&#xE713;" Style="{StaticResource OnNavyIconButton}"
                            Click="OnOpenManage" IsEnabled="False" ToolTip="관리" />
                    <Rectangle Width="1" Height="16" Fill="{StaticResource OnNavyPressed}" Margin="4,0" />
                    <Button Content="&#xE76B;" Style="{StaticResource OnNavyIconButton}" Click="OnCollapse"
                            ToolTip="접기 · Esc" />
                    <Button Content="&#xE7E8;" Style="{StaticResource OnNavyIconButton}" Click="OnExit"
                            ToolTip="onTalk.sAIde 끝내기 (온톡은 그대로 둡니다)" />
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="8" Width="52" Height="30" Margin="0,0,10,0">
                        <TextBlock Foreground="{StaticResource Navy}" FontWeight="ExtraBold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="s" /><Run Text="AI" Foreground="{StaticResource Accent}" /><Run Text="de" /></TextBlock>
                    </Border>
                    <TextBlock Grid.Column="1" x:Name="WindowSubtitle" Text="온톡 작업 도우미" Foreground="White"
                               FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 연결 상태 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Border x:Name="StatusChip" Background="{StaticResource PageBg}" CornerRadius="12" Padding="10,4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9CA3AF" VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="온톡을 찾는 중" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="290" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 계정 연결 확인 -->
        <Border x:Name="AccountBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoft}"
                BorderBrush="{StaticResource WarnLine}" BorderThickness="0,0,0,1" Padding="14,12"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock x:Name="AccountText" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,10"
                               Text="연결하면 이 PC에서 연 쪽지를 계정별 암호화 저장소에 보관합니다. 연결 전에는 아무것도 읽어 저장하지 않습니다." />
                    <Button x:Name="ConfirmButton" Content="이 계정으로 연결" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}" Click="OnConfirmAccount" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="ContextHeader" DockPanel.Dock="Top" Padding="14,10" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ContextTitle" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="ContextHint" Style="{StaticResource Small}" Margin="0,4,0,0" />
                <StackPanel x:Name="ManualMenuPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="메뉴를 읽지 못하면 직접 지정" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="MenuPicker" SelectedIndex="0" SelectionChanged="OnManualMenuChanged">
                        <ComboBoxItem Content="자동 감지" Tag="Unknown" />
                        <ComboBoxItem Content="친구" Tag="Friends" />
                        <ComboBoxItem Content="조직도" Tag="Organization" />
                        <ComboBoxItem Content="대화" Tag="Conversations" />
                        <ComboBoxItem Content="쪽지" Tag="Notes" />
                        <ComboBoxItem Content="사용자 검색·알리미 (지원 제외)" Tag="Excluded" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 발아래 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Text="Ctrl+Shift+Space" />
                <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="ContextView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ContextPurpose" Style="{StaticResource Body}" />
                            <TextBlock x:Name="ContextTools" Style="{StaticResource Small}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ContextScope" Style="{StaticResource Small}" Margin="2,4,2,12" />
                    <Button x:Name="ContextPrimary" Content="새 쪽지 준비" Style="{StaticResource PrimaryButton}" Click="OnContextPrimary" />
                    <Button x:Name="ContextSearch" Content="보관한 쪽지에서 찾기" Margin="0,8,0,0" Click="OnOpenSearch" />
                </StackPanel>
            </ScrollViewer>
            <ContentControl x:Name="ComposeHost" Visibility="Collapsed" />
            <ContentControl x:Name="PeopleHost" Visibility="Collapsed" />
            <ContentControl x:Name="ChatHost" Visibility="Collapsed" />

            <!-- 아직 쪽지가 없을 때 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0,28,40">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyText" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Muted}" LineHeight="20"
                           Text="온톡에서 받은 쪽지를 열면 여기에 표시됩니다." />
            </StackPanel>

            <DockPanel x:Name="NoteView" Visibility="Collapsed">
                <!-- 쪽지 머리: 보낸 사람과 시각 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1" Padding="14,14,14,14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock x:Name="SenderInitial" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SenderText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock x:Name="SenderDetailText" Style="{StaticResource Small}" Margin="0,1,0,0" />
                                <TextBlock x:Name="TimeText" Style="{StaticResource Small}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Chip}" Margin="0,10,0,0">
                            <TextBlock x:Name="CaptureText" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                       Foreground="{StaticResource AccentText}" />
                        </Border>
                        <Button Content="답장 초안 쓰기" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                MinHeight="36" Click="OnReplyDraft" />
                    </StackPanel>
                </Border>

                <TabControl Style="{StaticResource PillTabs}">
                    <TabItem Header="정리">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{StaticResource TextStrong}" FontWeight="Normal">
                            <StackPanel Margin="12,0,12,12">
                                <Border x:Name="AnalysisStatusPanel" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Spinner}"
                                                       Margin="0,2,10,0" VerticalAlignment="Top">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="AnalysisStatusText" TextWrapping="Wrap" LineHeight="19"
                                                       Foreground="{StaticResource TextStrong}" />
                                        </DockPanel>
                                        <Button x:Name="RetryButton" Content="다시 분석" HorizontalAlignment="Left"
                                                Margin="0,10,0,0" Click="OnRetryAnalysis" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SummarySection" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}">
                                            <Run Style="{StaticResource SectionIcon}" Text="&#xE8BD;" /><Run Text="  요약" />
                                        </TextBlock>
                                        <TextBlock x:Name="SummaryText" Style="{StaticResource Body}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text="AI가 쓴 요약입니다. 원문과 다를 수 있으니 중요한 내용은 원문에서 확인하세요." />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CandidateSection" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}">
                                            <Run Style="{StaticResource SectionIcon}" Text="&#xE73E;" /><Run Text="  할 일 후보" />
                                        </TextBlock>
                                        <TextBlock x:Name="NoCandidateText" Style="{StaticResource Small}"
                                                   Text="이 쪽지에서 해야 할 일을 찾지 못했습니다." />
                                        <ItemsControl x:Name="CandidateList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanRegister}">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" LineHeight="19" />
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding DueLine}" Style="{StaticResource Small}"
                                                                   Margin="27,3,0,0" />
                                                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="2,0,0,0"
                                                                Padding="8,0,0,0" Margin="27,5,0,0">
                                                            <TextBlock Text="{Binding EvidenceLine}" Style="{StaticResource Caption}"
                                                                       FontStyle="Italic" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="DroppedText" Style="{StaticResource Caption}" Margin="0,0,0,10"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="RegisterButton" Content="선택한 항목을 업무로 등록"
                                                HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                                Click="OnRegisterCandidates" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UncertainSection" Style="{StaticResource Card}" Visibility="Collapsed"
                                        Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}">
                                            <Run FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Warn}" Text="&#xE7BA;" /><Run Text="  확인이 필요한 점" />
                                        </TextBlock>
                                        <ItemsControl x:Name="UncertainList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="2,0,8,0"
                                                                   Foreground="{StaticResource Warn}" />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="19" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}">
                                            <Run Style="{StaticResource SectionIcon}" Text="&#xE8FB;" /><Run Text="  이 쪽지의 업무" />
                                        </TextBlock>
                                        <TextBlock x:Name="NoTaskText" Style="{StaticResource Small}"
                                                   Text="등록한 업무가 없습니다." />
                                        <ItemsControl x:Name="NoteTaskList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <CheckBox IsChecked="{Binding Done, Mode=OneWay}" Tag="{Binding Id}"
                                                                  Click="OnToggleTask">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TaskTitle}" />
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding DueLine}" Style="{StaticResource Small}"
                                                                   Margin="27,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}">
                                            <Run Style="{StaticResource SectionIcon}" Text="&#xE710;" /><Run Text="  업무 직접 추가" />
                                        </TextBlock>
                                        <TextBox x:Name="ManualTitle" Tag="할 일을 적어 주세요" />
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource PrimaryButton}"
                                                    Margin="8,0,0,0" Padding="18,0" Click="OnAddManualTask" />
                                            <DatePicker x:Name="ManualDue" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text="기한을 정한 업무만 전날 9시와 당일 9시에 알립니다." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="원문">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{StaticResource TextStrong}" FontWeight="Normal">
                            <StackPanel Margin="12,0,12,12">
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                             Background="Transparent" Padding="14,12" MinHeight="120"
                                             VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" />
                                </Border>
                                <Border x:Name="AttachmentPanel" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="AttachmentTitle" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl x:Name="AttachmentList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8"
                                                            Padding="10,8" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="18"
                                                                       Foreground="{StaticResource Muted}" Margin="0,2,10,0"
                                                                       VerticalAlignment="Top" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                    <Button Content="가져오기" Style="{StaticResource SmallButton}"
                                                                            Tag="{Binding Id}" Click="OnImportAttachment" />
                                                                    <Button Content="내보내기" Style="{StaticResource SmallButton}"
                                                                            Margin="6,0,0,0" Tag="{Binding Id}"
                                                                            IsEnabled="{Binding Stored}" Click="OnExportAttachment" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="온톡에서 '저장'으로 받은 파일을 '가져오기'로 고르면 암호화해 보관합니다. 온톡의 첨부파일은 7일 뒤 지워집니다." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
    </Grid>
    </Border>
</Window>
