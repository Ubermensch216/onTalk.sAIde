<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 온톡의 남색 사이드바·파란 알약 탭·흰 카드·옅은 회색 바탕을 따른다. -->

    <!-- 색 -->
    <Color x:Key="AccentColor">#3A6CFF</Color>
    <SolidColorBrush x:Key="Accent" Color="#3A6CFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#2E5BE8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#2549C4" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF" />
    <SolidColorBrush x:Key="AccentText" Color="#2A58E0" />

    <SolidColorBrush x:Key="Navy" Color="#034697" />
    <SolidColorBrush x:Key="NavyDeep" Color="#00316B" />
    <SolidColorBrush x:Key="OnNavyHover" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="OnNavyPressed" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="OnNavyMuted" Color="#B8CBEB" />

    <SolidColorBrush x:Key="PageBg" Color="#F1F3F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F6F8FB" />
    <SolidColorBrush x:Key="Line" Color="#E4E8F0" />
    <SolidColorBrush x:Key="LineStrong" Color="#D2D8E4" />
    <SolidColorBrush x:Key="TextStrong" Color="#18202F" />
    <SolidColorBrush x:Key="Muted" Color="#667085" />
    <SolidColorBrush x:Key="Subtle" Color="#98A2B3" />
    <SolidColorBrush x:Key="HoverBg" Color="#F2F5FB" />

    <SolidColorBrush x:Key="Danger" Color="#D92D20" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEEFED" />
    <SolidColorBrush x:Key="Success" Color="#12A150" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E6F6EC" />
    <SolidColorBrush x:Key="Warn" Color="#B54708" />
    <SolidColorBrush x:Key="WarnDot" Color="#F79009" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF5E0" />
    <SolidColorBrush x:Key="WarnLine" Color="#F7D9A4" />

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.07" Color="#101828" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#101828" />

    <!-- 밀도: 기본값은 작업 패널용. 쪽지 보내기 창처럼 작게 쓰는 창은 같은 키를 창 자원에서 다시 정해 줄인다. -->
    <sys:Double x:Key="CtlMinHeight">32</sys:Double>
    <Thickness x:Key="CtlPadding">14,0</Thickness>
    <sys:Double x:Key="SmallMinHeight">26</sys:Double>
    <Thickness x:Key="SmallPadding">10,0</Thickness>
    <sys:Double x:Key="FieldMinHeight">34</sys:Double>
    <Thickness x:Key="FieldPadding">10,0</Thickness>
    <Thickness x:Key="MultilinePadding">12,10</Thickness>
    <Thickness x:Key="ComboPadding">10,0,30,0</Thickness>
    <Thickness x:Key="ComboItemPadding">10,7</Thickness>
    <sys:Double x:Key="GridHeaderHeight">32</sys:Double>
    <sys:Double x:Key="GridRowMinHeight">30</sys:Double>
    <Thickness x:Key="GridCellPadding">10,0</Thickness>
    <sys:Double x:Key="TabHeight">30</sys:Double>
    <CornerRadius x:Key="TabRadius">15</CornerRadius>
    <CornerRadius x:Key="TabBarRadius">18</CornerRadius>
    <Thickness x:Key="TabBarPadding">3</Thickness>
    <Thickness x:Key="TabBarMargin">12,2,12,10</Thickness>
    <sys:Double x:Key="CheckSize">18</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="LineSmall">17</sys:Double>
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="LineCaption">15</sys:Double>
    <sys:Double x:Key="FontPageTitle">17</sys:Double>

    <!-- 글자 -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Malgun Gothic" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="Background" Value="{StaticResource PageBg}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Small" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="{DynamicResource LineSmall}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Small}">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="LineHeight" Value="{DynamicResource LineCaption}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontPageTitle}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- 결과·상태를 알리는 글. 비어 있으면 자리를 차지하지 않는다. -->
    <Style x:Key="StatusLine" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusSmall" TargetType="TextBlock" BasedOn="{StaticResource Small}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 업무 제목: 끝낸 업무는 흐리게 줄을 긋는다. -->
    <Style x:Key="TaskTitle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter Property="TextDecorations" Value="Strikethrough" />
                <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 흰 카드 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 알약 모양 상태 표시 -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- 단추 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource CtlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource CtlMinHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#DCE6FF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentHover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentPressed}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource NavyDeep}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="#F2B8B2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource DangerSoft}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 작은 보조 단추 (목록 줄 안) -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource SmallMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource SmallPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
    </Style>

    <!-- 글자만 있는 단추 -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="6" Padding="6,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 그림 단추. 어두운 바탕(남색 머리줄) 위에서 쓴다. -->
    <Style x:Key="OnNavyIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource OnNavyHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource OnNavyPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 접힌 도구의 세로 단추 -->
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource OnNavyIconButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 흰 바탕의 그림 단추 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource HoverBg}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 입력칸 -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource FieldPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource FieldMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- Tag에 적은 글이 비어 있을 때 흐리게 보이는 안내 -->
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Subtle}"
                                       Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#B6C2DA" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}" />

    <!-- 길게 쓰는 글(초안 편집기, 원문)은 위아래로 여유를 둔다. -->
    <Style x:Key="MultilineBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Padding" Value="{DynamicResource MultilinePadding}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="PasswordField" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource FieldPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource FieldMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#B6C2DA" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordField}" />

    <!-- 체크 상자 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="{DynamicResource CheckSize}" Height="{DynamicResource CheckSize}" CornerRadius="5" Margin="0,1,0,0" VerticalAlignment="Top"
                                BorderThickness="1.5" BorderBrush="#B3BCCE" Background="{StaticResource Surface}">
                            <Path x:Name="Tick" Data="M3.5,8.5 L7,12 L13.5,4.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="None" Margin="-1.5,-1.5,0,0" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 스크롤 막대: 얇고 둥글게, 마우스를 올리면 굵어진다. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="#C5CCDA" CornerRadius="4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#9AA5BC" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#7C89A6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollNoButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollNoButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollNoButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollNoButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollNoButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 알약 탭: 온톡의 받은 쪽지/보낸 쪽지 탭과 같은 모양 -->
