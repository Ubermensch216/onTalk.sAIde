            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Pill" Background="Transparent" CornerRadius="{DynamicResource TabRadius}" Height="{DynamicResource TabHeight}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#E3E8F3" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="White" />
