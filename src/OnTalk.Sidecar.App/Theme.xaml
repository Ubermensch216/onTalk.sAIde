                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#E9EDF5" CornerRadius="{DynamicResource TabBarRadius}" Padding="{DynamicResource TabBarPadding}" Margin="{DynamicResource TabBarMargin}">
