<Window x:Class="OnTalk.Sidecar.App.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="할 일 목록 · onTalk.sAIde" Width="560" Height="640" MinWidth="440" MinHeight="320"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <DockPanel MaxWidth="760">
                <CheckBox x:Name="ShowDone" DockPanel.Dock="Right" Content="완료한 업무도 보기"
                          VerticalAlignment="Center" Click="OnFilterChanged" />
                <StackPanel>
                    <TextBlock Text="할 일 목록" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Small}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <StackPanel x:Name="EmptyBox" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                        IsHitTestVisible="False">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyText" Text="등록한 업무가 없습니다." Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TaskList" Margin="20,16,20,10" MaxWidth="760">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                                Margin="10,0,0,0">
                                        <DatePicker Width="132" SelectedDate="{Binding Due, Mode=OneWay}" Tag="{Binding Id}"
                                                    SelectedDateChanged="OnDueChanged" />
                                        <Button Content="삭제" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                                MinHeight="34" Padding="12,0" Tag="{Binding Id}" Click="OnDelete" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Done, Mode=OneWay}" Tag="{Binding Id}" Click="OnToggle">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TaskTitle}" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding DueLine}" Style="{StaticResource Small}" Margin="27,3,0,0" />
                                        <TextBlock Text="{Binding Origin}" Style="{StaticResource Caption}" Margin="27,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
