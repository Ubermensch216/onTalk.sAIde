<Window x:Class="OnTalk.Sidecar.App.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="할 일 목록 · onTalk.sAIde" Width="560" Height="600" MinWidth="420" MinHeight="300"
        FontFamily="Malgun Gothic" FontSize="13" Background="White" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel>
                <CheckBox x:Name="ShowDone" DockPanel.Dock="Right" Content="완료한 업무도 보기"
                          VerticalAlignment="Center" Click="OnFilterChanged" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock x:Name="EmptyText" Text="등록한 업무가 없습니다." Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TaskList" Margin="14,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="삭제" Padding="8,1" Margin="8,0,0,0"
                                            VerticalAlignment="Top" Tag="{Binding Id}" Click="OnDelete" />
                                    <DatePicker DockPanel.Dock="Right" Width="120" VerticalAlignment="Top"
                                                SelectedDate="{Binding Due, Mode=OneWay}" Tag="{Binding Id}"
                                                SelectedDateChanged="OnDueChanged" />
                                    <StackPanel Margin="0,0,10,0">
                                        <CheckBox IsChecked="{Binding Done, Mode=OneWay}" Tag="{Binding Id}"
                                                  Click="OnToggle">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding DueLine}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" Margin="20,2,0,0" />
                                        <TextBlock Text="{Binding Origin}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" Margin="20,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
